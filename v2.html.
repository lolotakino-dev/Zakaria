<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة التداول البرمجية المتقدمة</title>
    <style>
        :root {
            --bg-color: #080915;
            --card-bg: #111428;
            --neon-green: #00ffcc;
            --neon-red: #ff0055;
            --neon-blue: #00bfff;
            --neon-yellow: #ffcc00;
            --text-color: #ffffff;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 15px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--neon-blue);
            padding-bottom: 10px;
            box-shadow: 0 4px 15px rgba(0, 191, 255, 0.2);
        }

        .title { color: var(--neon-blue); text-shadow: 0 0 10px var(--neon-blue); margin: 0; font-size: 20px;}

        .controls {
            margin: 15px 0;
            display: flex;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .btn {
            background: #1a1e3b;
            color: #fff;
            border: 1px solid var(--neon-blue);
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            white-space: nowrap;
            transition: all 0.3s ease;
            box-shadow: 0 0 5px var(--neon-blue);
        }

        .btn:hover, .btn.active {
            background: var(--neon-blue);
            color: #000;
            box-shadow: 0 0 15px var(--neon-blue);
        }

        .grid {
            display: grid;
            grid-template-columns: 2.8fr 1.2fr;
            gap: 15px;
        }

        @media (max-width: 900px) {
            .grid { grid-template-columns: 1fr; }
        }

        .chart-container {
            background: var(--card-bg);
            border: 1px solid rgba(0, 255, 204, 0.3);
            border-radius: 12px;
            height: 640px;
            padding: 5px;
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.1);
        }

        .info-panel {
            background: var(--card-bg);
            border: 1px solid rgba(255, 0, 85, 0.3);
            border-radius: 12px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .card {
            background: #181c37;
            padding: 10px;
            border-radius: 8px;
            border-right: 4px solid var(--neon-green);
        }

        .card.code-card { border-right-color: var(--neon-yellow); }

        .card h4 { margin: 0 0 5px 0; color: #aaa; font-size: 13px; }
        .card .val { font-size: 16px; font-weight: bold; margin-top: 3px; }

        textarea.code-input {
            width: 100%;
            height: 120px;
            background: #090b18;
            color: var(--neon-green);
            border: 1px solid var(--neon-blue);
            border-radius: 6px;
            font-family: 'Consolas', 'Courier New', monospace;
            font-size: 12px;
            padding: 8px;
            box-sizing: border-box;
            resize: vertical;
            outline: none;
        }

        .neon-buy { color: var(--neon-green); text-shadow: 0 0 8px var(--neon-green); }
        .neon-sell { color: var(--neon-red); text-shadow: 0 0 8px var(--neon-red); }
    </style>
</head>
<body>

    <div class="header">
        <h1 class="title">منصة التداول والتحليل البرمجي ⚡</h1>
        <div id="live-clock" style="color: var(--neon-green)">--:--:--</div>
    </div>

    <div class="controls">
        <button class="btn active" onclick="changeSymbol('BTCUSDT', 'BINANCE:BTCUSDT')">بيتكوين (BTC)</button>
        <button class="btn" onclick="changeSymbol('ETHUSDT', 'BINANCE:ETHUSDT')">إيثريوم (ETH)</button>
        <button class="btn" onclick="changeSymbol('SOLUSDT', 'BINANCE:SOLUSDT')">سولانا (SOL)</button>
        <button class="btn" onclick="changeSymbol('XRPUSDT', 'BINANCE:XRPUSDT')">ريبل (XRP)</button>
    </div>

    <div class="grid">
        <div class="chart-container">
            <div id="tradingview_chart" style="height:100%; width:100%;"></div>
        </div>

        <div class="info-panel">
            <div class="card code-card">
                <h4>💻 محرر خوارزميات (Pine Script / JS)</h4>
                <textarea id="customCode" class="code-input" placeholder="// اكتب أو الصق كود Pine Script / JS هنا...
//@version=5
indicator('My SMC Strategy', overlay=true)
plot(close)"></textarea>
                <div style="display: flex; gap: 5px; margin-top: 8px;">
                    <button class="btn" style="flex: 1; padding: 5px; font-size: 11px;" onclick="runCustomScript()">تطبيق الخوارزمية</button>
                    <button class="btn" style="flex: 1; padding: 5px; font-size: 11px; border-color: var(--neon-green);" onclick="copyPineScript()">نسخ للـ TradingView</button>
                </div>
                <small id="codeStatus" style="color: var(--neon-green); font-size: 10px; display: block; margin-top: 5px;"></small>
            </div>

            <div class="card">
                <h4>التنبوء والاتجاه العام الحقيقي</h4>
                <div class="val" id="signal-text">جاري التحميل...</div>
            </div>

            <div class="card">
                <h4>مستويات الدعم الحقيقية (Support)</h4>
                <div class="val neon-buy">S1: <span id="s1">0.00</span></div>
                <div class="val neon-buy">S2: <span id="s2">0.00</span></div>
            </div>

            <div class="card sell">
                <h4>مستويات المقاومة الحقيقية (Resistance)</h4>
                <div class="val neon-sell">R1: <span id="r1">0.00</span></div>
                <div class="val neon-sell">R2: <span id="r2">0.00</span></div>
            </div>
        </div>
    </div>

    <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
    <script type="text/javascript">
        let currentApiSymbol = 'BTCUSDT';
        let currentTvSymbol = 'BINANCE:BTCUSDT';

        function loadChart(tvSymbol) {
            new TradingView.widget({
                "autosize": true,
                "symbol": tvSymbol,
                "interval": "D",
                "timezone": "Etc/UTC",
                "theme": "dark",
                "style": "1",
                "locale": "ar",
                "enable_publishing": true,
                "withdateranges": true,
                "hide_side_toolbar": false,
                "allow_symbol_change": true,
                "details": true,
                "hotlist": true,
                "calendar": true,
                "studies": [
                    "STD;MACD",
                    "STD;RSI"
                ],
                "show_popup_button": true,
                "popup_width": "1000",
                "popup_height": "650",
                "container_id": "tradingview_chart"
            });
        }

        async function fetchRealData(symbol) {
            try {
                const response = await fetch(`https://api.binance.com/api/v3/ticker/24hr?symbol=${symbol}`);
                const data = await response.json();

                const high = parseFloat(data.highPrice);
                const low = parseFloat(data.lowPrice);
                const close = parseFloat(data.lastPrice);
                const priceChange = parseFloat(data.priceChangePercent);

                const P = (high + low + close) / 3;
                const r1 = (2 * P) - low;
                const s1 = (2 * P) - high;
                const r2 = P + (high - low);
                const s2 = P - (high - low);

                document.getElementById('r1').innerText = r1.toFixed(2) + ' $';
                document.getElementById('r2').innerText = r2.toFixed(2) + ' $';
                document.getElementById('s1').innerText = s1.toFixed(2) + ' $';
                document.getElementById('s2').innerText = s2.toFixed(2) + ' $';

                const signalEl = document.getElementById('signal-text');
                if (priceChange > 1.5) {
                    signalEl.className = 'val neon-buy';
                    signalEl.innerText = `شراء (Strong Buy) +${priceChange.toFixed(2)}%`;
                } else if (priceChange < -1.5) {
                    signalEl.className = 'val neon-sell';
                    signalEl.innerText = `بيع (Strong Sell) ${priceChange.toFixed(2)}%`;
                } else {
                    signalEl.className = 'val';
                    signalEl.style.color = 'var(--neon-yellow)';
                    signalEl.innerText = `محايد (${priceChange.toFixed(2)}%)`;
                }
            } catch (err) {
                console.error("خطأ في البيانات:", err);
            }
        }

        function runCustomScript() {
            const code = document.getElementById('customCode').value;
            if(!code) return;
            try {
                const runJS = new Function(code);
                runJS();
                document.getElementById('codeStatus').innerText = "تم تشغيل الكود بنجاح!";
            } catch (e) {
                document.getElementById('codeStatus').innerText = "Pine Script: استخدم زر النسخ وافتحه في نافذة المؤشرات.";
            }
        }

        function copyPineScript() {
            const code = document.getElementById('customCode').value;
            navigator.clipboard.writeText(code);
            document.getElementById('codeStatus').innerText = "تم نسخ كود Pine Script بنجاح!";
        }

        function changeSymbol(apiSymbol, tvSymbol) {
            currentApiSymbol = apiSymbol;
            currentTvSymbol = tvSymbol;
            loadChart(tvSymbol);
            fetchRealData(apiSymbol);
        }

        loadChart(currentTvSymbol);
        fetchRealData(currentApiSymbol);

        setInterval(() => { fetchRealData(currentApiSymbol); }, 10000);
        setInterval(() => { document.getElementById('live-clock').innerText = new Date().toLocaleTimeString('ar-EG'); }, 1000);
    </script>
</body>
</html>
